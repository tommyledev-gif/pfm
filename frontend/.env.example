# Copy to `.env.local` for local `npm run dev` outside Docker.
# Inside Docker Compose, API_PROXY_TARGET is injected by docker-compose.yml instead.

# Server-side only — never sent to the browser. Where the BFF proxy route
# (src/app/api/proxy/[...path]/route.ts) forwards requests to the Go backend.
API_PROXY_TARGET=http://localhost:8090
