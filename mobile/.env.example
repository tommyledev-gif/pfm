# Copy to `.env` (gitignored) and adjust for your machine.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code — anything
# without that prefix is server-only (irrelevant here, there is no server).

# Reachable from your device/simulator, not the Docker-internal "backend"
# hostname — on a physical device this must be your machine's LAN IP, not
# localhost (e.g. http://192.168.1.20:8090/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8090/api/v1

# Optional. Google Maps API key (Maps SDK for Android, restricted to this app's
# package + signing SHA-1) for the transaction location map in Android builds —
# Expo Go needs none. Unset: the location step shows coordinates and a link to
# Google Maps instead of a map. Wired by app.config.js; for EAS builds put it
# in eas.json's build profile `env` as well.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
