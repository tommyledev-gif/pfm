# Copy this file to `.env` and adjust values for your machine.
# `.env` is gitignored — it holds local dev secrets, never commit it.
# docker-compose.yml reads every value below via ${VAR} — nothing is
# hardcoded in the compose file itself.

# ---- PostgreSQL ----
POSTGRES_USER=pfm
POSTGRES_PASSWORD=REPLACE_ME_local_dev_password
POSTGRES_DB=pfm
# Host port exposed for local tools (DBeaver/psql). Container always listens on 5432 internally.
POSTGRES_PORT=5432

# ---- Go backend ----
# Host port the API is reachable on (matches your current `$env:PORT` local run).
BACKEND_PORT=8090
# openssl rand -hex 32  (or: python -c "import secrets;print(secrets.token_hex(32))")
# Generate with: openssl rand -hex 32. The server refuses to start with fewer than
# 32 bytes, so leaving this placeholder fails loudly instead of running with a
# secret everyone can guess.
JWT_SECRET=change_me
# Origins allowed to call the API from a browser — Next.js web (8082), plus
# Expo's web preview (`npx expo start --web`, Metro's default port 8081) if used.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# ---- SMTP (activation email — see backend/internal/service/smtp_email_sender.go) ----
# Leave SMTP_HOST blank to fall back to the log-only placeholder sender (no real email sent).
# For Gmail: smtp.gmail.com, port 587, and SMTP_PASSWORD must be a 16-char
# Google "App Password" (myaccount.google.com/apppasswords) — Gmail rejects
# your normal account password for SMTP once 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=PFM
# Web frontend origin the activation link in the email points at.
APP_BASE_URL=http://localhost:8082

# ---- Dev-only admin seed (first init of the postgres volume only) ----
# Bcrypt hash of the password below — generate your own with:
#   go run ./backend/cmd/hashgen "<your-password>"
# Plaintext for the hash shipped here: DevAdmin@123 — change it after first login.
ADMIN_SEED_EMAIL=admin@pfm.local
ADMIN_SEED_PASSWORD_HASH=REPLACE_ME_bcrypt_hash__run__go_run_./cmd/hashgen

# ---- Mobile (React Native + Expo, mobile/) ----
# Not containerized — Expo's dev flow is `npx expo start`, not docker-compose.
# See mobile/.env.example for its own EXPO_PUBLIC_API_BASE_URL, which must
# point at BACKEND_PORT above (reachable from a device/simulator, not the
# Docker-internal "backend" hostname).

# ---- Next.js web frontend (frontend/) ----
WEB_FRONTEND_PORT=8082
# Server-side only (never sent to the browser) — the Next.js BFF proxy route
# uses this to reach the backend over the Docker network.
API_PROXY_TARGET=http://backend:8080

# ---- AI Service (ai-service/) — Feature-12 AI Chat Assistant ----
# Groq is primary (free tier); Anthropic is a fallback only. Leave blank to
# disable — POST /ai/chat degrades to 502 AI_SERVICE_UNAVAILABLE rather than
# failing to start. Never commit real values here.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret between backend and ai-service (both containers read it).
# Blank = not enforced. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=
# Reading receipt photos — "true" turns POST /transactions/image-proposals on.
AI_IMAGE_ENABLED=false
# Account the test-phase deletion tool opens to; blank = nobody.
ACCOUNT_DELETION_OPERATOR_EMAIL=
