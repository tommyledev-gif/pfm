# ======================================================================
# PHẦN A — nội dung để dán làm value của secret GitHub tên "VPS_ENV_PROD"
# (copy đúng phần giữa 2 dòng ===== bên dưới, KHÔNG copy 2 dòng ===== đó)
# ======================================================================
# =====BEGIN=====
# ---- PostgreSQL (pfm-postgres container) ----
POSTGRES_USER=pfm
POSTGRES_PASSWORD=pfm
POSTGRES_DB=pfm
POSTGRES_PORT_EXTERNAL=5432

# ---- Go backend ----
JWT_SECRET=sample-secret-key
# Domain sẽ trỏ tới backend này qua Cloudflare — xem PHẦN C bước domain.
CORS_ALLOWED_ORIGINS=https://sample.id.vn
BACKEND_PORT_EXTERNAL=80

# ---- SMTP (activation email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sample@gmail.com
SMTP_PASSWORD=samplepassword
SMTP_FROM_EMAIL=sample@gmail.com
SMTP_FROM_NAME=PFM
APP_BASE_URL=https://sample.id.vn

# ---- AI Service ----
# Để trống — backend tự fallback sang http://ai-service:8000 (xem
# backend/internal/config/config.go), chỉ set nếu muốn trỏ tới chỗ khác.
AI_SERVICE_URL=
# GitHub push protection sẽ chặn commit nếu key thật nằm ở đây — KHÔNG paste
# key thật vào file này. Khi dán PHẦN A vào ô secret VPS_ENV_PROD trên
# GitHub, tự tay thay dòng dưới bằng key Groq thật (key cũ đã lộ nhiều nơi,
# nên tạo key mới trong Groq console rồi dùng key đó, không dùng lại key cũ).
GROQ_API_KEY=sample-groq-api-key
# Shared secret between backend and ai-service (>= 32 bytes, `openssl rand -hex 32`).
# Set it only AFTER both new images are deployed (docs/ops-runbook.md §9);
# blank = ai-service does not require the header yet.
AI_SERVICE_TOKEN=

# ---- Memory limits — VPS có 2GB RAM, dùng mức mặc định trong docker-compose.yml ----
MEM_LIMIT_POSTGRES=512M
MEM_LIMIT_BACKEND=512M
MEM_LIMIT_AI_SERVICE=256M
# =====END=====
SEED_ADMIN_EMAIL=sample@gmail.com
SEED_ADMIN_PASSWORD=samplepassword

R2_PUBLIC_BASE_URL=https://pub-sample.r2.dev
R2_ACCESS_KEY_ID=sample-access-key
R2_ACCOUNT_ID=sample-account-id
R2_SECRET_ACCESS_KEY=sample-secret-access-key
R2_BUCKET=pfm

BACKUP_R2_ACCESS_KEY_ID=sample-backup-access-key
BACKUP_R2_SECRET_ACCESS_KEY=sample-backup-secret-access-key
BACKUP_R2_BUCKET=pfm-backups
CLOUDFLARE_TUNNEL_TOKEN=sample-cloudflare-tunnel-token
BACKEND_BIND_ADDRESS=127.0.0.1

WEBAUTHN_RP_ID=sample.id.vn
ANDROID_APP_PACKAGE=com.sample.contact.pfm
ANDROID_CERT_SHA256=sample-cert-sha256
AI_IMAGE_ENABLED=true
# The APK link people see, once app.example.com routes to this server
# through the tunnel (docs/ops-runbook.md section 8). Blank: the API path.
APK_PUBLIC_URL=
# The one account the test-phase account deletion tool (Security screen) opens
# to. Blank closes it for everyone (docs/ops-runbook.md section 9).
ACCOUNT_DELETION_OPERATOR_EMAIL=
