# Reference for the VPS_ENV_PROD GitHub secret — the workflow writes its
# contents verbatim to .env.prod on the VPS. Never commit real values.
# See backend/internal/config/config.go for how the Go process reads these.

# ---- PostgreSQL (pfm-postgres container) ----
POSTGRES_USER=pfm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pfm
# Bound to 127.0.0.1 only — override just for one-off debugging via SSH tunnel.
POSTGRES_PORT_EXTERNAL=5432

# ---- Go backend ----
# openssl rand -hex 32
# Generate with: openssl rand -hex 32. The server refuses to start with fewer than
# 32 bytes, so leaving this placeholder fails loudly instead of running with a
# secret everyone can guess.
JWT_SECRET=change_me
# Origins allowed to call the API from a browser (web frontend, mobile web preview).
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
# Port exposed on the VPS host — 80 so Cloudflare/the reverse proxy can reach it.
BACKEND_PORT_EXTERNAL=80

# ---- SMTP (activation email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=PFM
# Web frontend origin the activation link in the email points at.
APP_BASE_URL=https://your-frontend-domain.example

# ---- First admin bootstrap (cmd/seed, run by deploy.sh on every deploy) ----
# Invite-only auth means a fresh environment has no one to invite the first
# user — set these only until the admin account exists, then blank them out
# (or just change the password after first login; re-running seed after that
# is a safe no-op either way, see db/queries/users.sql SeedAdminUser).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# ---- AI Service ----
# ai-service is deployed by backend/docker-compose.yml as the "ai-service"
# container. Leave AI_SERVICE_URL blank — the Go backend's built-in default
# (http://ai-service:8000, see internal/config/config.go) already resolves
# to it; only set this if you point at an ai-service instance elsewhere.
# If GROQ_API_KEY is blank, ai-service starts but every /extract call fails,
# so POST /ai/chat still degrades to 502 AI_SERVICE_UNAVAILABLE.
AI_SERVICE_URL=
GROQ_API_KEY=your-groq-api-key
# Reading receipt photos (specs/ai-chat-image-capture). Keep false until the
# accuracy check passed AND "Inference APIs ZDR" is on in the Groq console
# (Settings > Data Controls) — images go to Groq. "true" turns it on.
AI_IMAGE_ENABLED=false
ANTHROPIC_API_KEY=

# ---- Cloudflare R2 (user-uploaded category icons) ----
# Create a bucket in the Cloudflare dashboard (R2 > Create bucket), then an
# R2 API token (R2 > Manage API Tokens > Create API Token, "Object Read &
# Write", scoped to this bucket) for the access key/secret below. Leave
# R2_ACCOUNT_ID blank to disable uploads — POST /categories/icon then
# degrades to 503 ICON_UPLOAD_UNAVAILABLE instead of failing startup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pfm-category-icons
# The bucket has no public HTTP access on its own — enable the bucket's
# public r2.dev URL (R2 > bucket > Settings > Public access) or front it
# with a custom domain, and put that origin here (no trailing slash).
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ---- Passkeys (WebAuthn, mig 032) ----
# The domain passkeys are bound to — this API's own host. Leave blank to turn
# passkeys off (their endpoints answer 503 PASSKEYS_UNAVAILABLE; password
# sign-in is unaffected).
WEBAUTHN_RP_ID=api.example.com
# Extra web origins allowed to run a ceremony, comma-separated. https://<RP ID>
# is always allowed; leave blank for the app alone.
WEBAUTHN_RP_ORIGINS=
# Served as /.well-known/assetlinks.json — Android checks it before letting
# the app use passkeys for the domain above. ANDROID_CERT_SHA256 is the
# SHA-256 fingerprint of the app's signing certificate, colon hex as
# `eas credentials` (Android > Keystore) or keytool prints it; add the
# debug/dev-build keystore's too, comma-separated, to test on a dev build.
ANDROID_APP_PACKAGE=com.example.pfm
ANDROID_CERT_SHA256=

# ---- Postgres backups + log archive to R2 (backend/ops/, docs/ops-runbook.md) ----
# ⚠️ A SEPARATE, PRIVATE bucket — never the icon bucket above, which is public.
# Its own API token, "Object Read & Write" scoped to this bucket only. Leave
# BACKUP_R2_BUCKET blank and deploy.sh schedules nothing (and says so).
# BACKUP_R2_ACCOUNT_ID falls back to R2_ACCOUNT_ID when blank.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=pfm-backups

# ---- Cloudflare Tunnel (docs/ops-runbook.md §Cloudflare Tunnel) ----
# Token of a tunnel whose public hostname points at http://pfm-backend:8080.
# Set it first and deploy (tunnel and public port both work); switch DNS;
# only then set BACKEND_BIND_ADDRESS=127.0.0.1 and deploy again to close
# the port. deploy.sh refuses 127.0.0.1 without a token.
CLOUDFLARE_TUNNEL_TOKEN=
BACKEND_BIND_ADDRESS=0.0.0.0

# ---- Container memory limits (optional, sane defaults in docker-compose.yml) ----
# 512M/512M assumes a VPS with >=2GB RAM. On a 1GB instance (e.g. AWS EC2
# t2.micro/t3.micro free tier) that leaves nothing for the OS + Docker
# daemon (~250-350MB idle) and will OOM — lower these instead, e.g.:
#   MEM_LIMIT_POSTGRES=256M
#   MEM_LIMIT_BACKEND=128M
# and make sure vps-bootstrap.sh's swapfile step ran (it's the backstop,
# not a substitute for right-sizing these).
MEM_LIMIT_POSTGRES=512M
MEM_LIMIT_BACKEND=512M
MEM_LIMIT_AI_SERVICE=256M
